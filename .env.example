AUTO_TRADE_TERMINAL_PATH=C:\\path\\to\\terminal64.exe
AUTO_TRADE_DATA_PATH=C:\\path\\to\\MetaQuotes\\Terminal\\<instance-hash>
AUTO_TRADE_INSTANCE_NAME=Alpari-MT5-Demo
AUTO_TRADE_SIGNAL_DIR=signals
AUTO_TRADE_LOG_DIR=logs
AUTO_TRADE_DRY_RUN=true
AUTO_TRADE_DEMO_ONLY=true
AUTO_TRADE_CONFIRMATION=SINGLE_CONFIRMATION

# Final execution controls are refused unless this is explicitly true.
# There is no default-on path. See docs/EXECUTION.md.
AUTO_TRADE_ENABLE_EXECUTION=false

# Closing a position is refused unless this is explicitly true, and it is
# separate from the execution opt-in: allowing an order never allows a close.
# Only a position this application opened, recorded in the execution ledger,
# can be closed this way. See docs/EXECUTION.md.
AUTO_TRADE_ENABLE_CLOSE=false

# Market-analysis library as 'module:attribute'. A file placed in the project's
# strategies/ directory is importable without installing anything.
# See docs/STRATEGY_INTEGRATION.md.
# AUTO_TRADE_STRATEGY=example_strategy:build
AUTO_TRADE_ALLOWED_SYMBOLS=EURUSD,XAUUSD,YM
AUTO_TRADE_MAX_VOLUME=1.0
AUTO_TRADE_MAX_ORDERS_PER_MINUTE=5
AUTO_TRADE_SIGNAL_EXPIRATION_SECONDS=10

# Optional authenticated signal sources. Configure exactly one: two at once is
# refused rather than resolved. Each must stay local and authenticated, and a
# fetched signal still passes every gate. Tokens are never logged, never printed
# by diagnostics, and must not be committed. See docs/SIGNAL_PROTOCOL.md.
# AUTO_TRADE_HTTP_SIGNAL_URL=http://127.0.0.1:8787/signals/next
# AUTO_TRADE_HTTP_SIGNAL_TOKEN=replace-me
# AUTO_TRADE_PIPE_SIGNAL_NAME=\\.\pipe\auto_trade_signals
# AUTO_TRADE_PIPE_SIGNAL_TOKEN=replace-me
# AUTO_TRADE_WS_SIGNAL_URL=ws://127.0.0.1:8787/signals
# AUTO_TRADE_WS_SIGNAL_TOKEN=replace-me
